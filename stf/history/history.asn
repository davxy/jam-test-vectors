-- Recent blocks history STF test vectors schema

HistoryModule DEFINITIONS ::= BEGIN

IMPORTS
    BlockInfo, RecentBlocks
        FROM JamTypes;

State ::= SEQUENCE {
    -- [β] Prior recent blocks information. Mutated to ϐ'.
    beta RecentBlocks
}

-- The block being appended to the recent blocks history.
Input ::= BlockInfo

Output ::= NULL

TestCase ::= SEQUENCE {
    input      Input,
    pre-state  State,
    output     Output,
    post-state State
}

END
